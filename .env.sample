DEBUG_ARTIFACTS_PATH=./data/interim/
DATA_PATH=./data/raw/invoices/
RANDOM_SEED=42
DATASET_NAME=kaggle_invoices

BERT_MODEL_NAME=google-bert/bert-base-uncased
BERT_MAX_LENGTH_TOKENS=512
BERT_MODEL_WINDOW_STRIDE=64
BERT_BATCH_SIZE=64
BERT_NUM_EPOCH=5
BERT_LEARNING_RATE=2e-5
BERT_WEIGHT_DECAY=0.01
BERT_GRADIENT_ACCUMULATION_STEPS=1
BERT_PER_DEVICE_TRAIN_BATCH_SIZE=16
BERT_PER_DEVICE_EVAL_BATCH_SIZE=16
BERT_EVAL_STRATEGY=epoch
BERT_SAVE_STRATEGY=epoch
BERT_LOGGING_STRATEGY=steps
BERT_LOGGING_STEPS=20
BERT_LOAD_BEST_MODEL_AT_END=true
BERT_METRIC_FOR_BEST_MODEL=f1
BERT_GREATER_IS_BETTER=true
BERT_DATALOADER_NUM_WORKERS=0

KAGGLE_INVOICES_DESTINATION_PATH=./data/raw/kaggle-invoices
KAGGLE_INVOICES_ARCHIVE_PATH=./data/raw/invoices-ocr.zip
KAGGLE_INVOICES_OUTPUT_PATH=./data/raw/kaggle-invoices.csv


DOCILE_DESTINATION_PATH=./data/raw/docile
DOCILE_OUTPUT_PATH=./data/raw/docile.parquet
DOCILE_SPLIT=trainval
DOCILE_USE_SNAPPED_BOXES=true
DOCILE_CORRECTIONS_PATH=
DOCILE_MINIMUM_ARCHIVE_BYTES=100000000
DOCILE_TOKEN=<DOCILE_TOKEN_ID>

BERTPYTORCH_DATASET_PATH=./data/raw/kaggle-invoices.csv
BERTPYTORCH_RESULT_FILENAME=bert_training_pipeline
BERTPYTORCH_DIAGNOSTIC_DIR=./data/interim/bert_diagnostics
BERTPYTORCH_CHECKPOINT_DIR=./data/interim/bert_pytorch_checkpoint
BERTPYTORCH_LINE_ITEMS_ONLY=false
BERTPYTORCH_MODEL_NAME=google-bert/bert-base-uncased
BERTPYTORCH_MAX_LENGTH_TOKENS=512
BERTPYTORCH_BATCH_SIZE=16
BERTPYTORCH_NUM_EPOCH=5
BERTPYTORCH_LEARNING_RATE=2e-5
BERTPYTORCH_WEIGHT_DECAY=0.01

BERT_PYTORCH_DEBUG_CHECKPOINT_DIR=./data/interim/bert_pytorch_checkpoint
BERT_PYTORCH_DEBUG_OUTPUT_DIR=./data/interim/bert_decoder_debug
BERT_PYTORCH_DEBUG_DEVICE=auto
