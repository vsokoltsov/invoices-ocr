DEBUG_ARTIFACTS_PATH=./data/interim/
DATA_PATH=./data/raw/invoices/
RANDOM_SEED=42
DOCILE_TOKEN=<DOCILE_TOKEN_ID>

BERT_MODEL_NAME=google-bert/bert-base-uncased
BERT_MAX_LENGTH_TOKENS=512
BERT_MODEL_WINDOW_STRIDE=64
BERT_BATCH_SIZE=64
BERT_NUM_EPOCH=5
BERT_LEARNING_RATE=2e-5
BERT_WEIGHT_DECAY=0.01
BERT_GRADIENT_ACCUMULATION_STEPS=1
BERT_PER_DEVICE_TRAIN_BATCH_SIZE=16
BERT_PER_DEVICE_EVAL_BATCH_SIZE=16
BERT_EVAL_STRATEGY=epoch
BERT_SAVE_STRATEGY=epoch
BERT_LOGGING_STRATEGY=steps
BERT_LOGGING_STEPS=20
BERT_LOAD_BEST_MODEL_AT_END=true
BERT_METRIC_FOR_BEST_MODEL=f1
BERT_GREATER_IS_BETTER=true
BERT_DATALOADER_NUM_WORKERS=0